# Reference papers (~60 MB of binaries). Not source, and every one is
# re-obtainable from the DOIs in RECOMMENDED_PAPERS.md. Delete this line if
# you want them versioned.
*.pdf

# Data and outputs (large; regenerate with scripts/prefetch.py).
# Leading slashes are required: a bare `data/` matches any directory of that
# name at any depth, which silently excluded the whole src/urbanintel/data
# acquisition package from version control.
/data/
/outputs/
*.tif
*.zip
*.part

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
.venv/
venv/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local dashboard server logs
*.log
*.log.err
