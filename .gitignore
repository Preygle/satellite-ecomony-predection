# Reference papers (~60 MB of binaries). Not source, and every one is
# re-obtainable from the DOIs in RECOMMENDED_PAPERS.md. Delete these lines if
# you want them versioned. Reports under docs/ ARE versioned - they are the
# deliverable, not a library.
/papers/*.pdf
/mentor_task/papers/*.pdf

# Data and outputs (large; regenerate with scripts/prefetch.py).
# Leading slashes are required: a bare `data/` matches any directory of that
# name at any depth, which silently excluded the whole src/urbanintel/data
# acquisition package from version control.
/data/
/outputs/
# Machine-specific paths (scripts/external_data.py link). Never tracked, so
# one person's data location cannot conflict with another's merge.
/config/local.yaml
# A separate git repository that happens to sit in this folder.
/gauntlet-loop/
*.tif
*.zip
*.part

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
.venv/
venv/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local dashboard server logs
*.log
*.log.err
